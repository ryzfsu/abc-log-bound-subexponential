/-!
# Short vectors in a tuple of corrected prime differences

The fresh entries determine every transverse integer coefficient. A short
vector on the generated lattice yields a code with a positive pivot and with
each coordinate bounded by the two-sided monomial height.

## Main results
* `AbcSubexp.TupleCounting.shortTuple_card_le`
-/

@[expose] public section

namespace AbcSubexp.TupleCounting


variable {ι Q : Type*} [Fintype ι] {n : ℕ}

/-- The old primes, the anchor, and the ordered fresh primes of a tuple. -/
def tuplePrimes (q : ι → ℕ) (prime : Q → ℕ) (t : Q × (Fin n → Q)) :
    ι ⊕ (Unit ⊕ Fin n) → ℕ :=
  Sum.elim q (Sum.elim (fun _ => prime t.1) (prime ∘ t.2))

/-- The integral vector generated by the axis and the fresh differences. -/
def tupleCombination (v : ι → ℤ) (lift : Q → Q → ι → ℤ) (t : Q × (Fin n → Q))
    (a : ℤ) (c : Fin n → ℤ) : ι ⊕ (Unit ⊕ Fin n) → ℤ :=
  Sum.elim (oldCombination v lift t a c) (Sum.elim (fun _ => -∑ j, c j) c)

omit [Fintype ι] in
private theorem tupleCombination_neg (v : ι → ℤ) (lift : Q → Q → ι → ℤ)
    (t : Q × (Fin n → Q)) (a : ℤ) (c : Fin n → ℤ) :
    tupleCombination v lift t (-a) (-c) = -tupleCombination v lift t a c := by
  funext i
  rcases i with i | (i | j)
  · simp [tupleCombination, oldCombination, Finset.sum_neg_distrib, add_comm]
  · simp [tupleCombination, Finset.sum_neg_distrib]
  · rfl

private theorem height_axis (q : ι → ℕ) (prime : Q → ℕ) (v : ι → ℤ)
    (lift : Q → Q → ι → ℤ) (t : Q × (Fin n → Q)) (a : ℤ) :
    AbcTwoNinths.Diamond.height (tuplePrimes q prime t) (tupleCombination v lift t a 0) =
      |(a : ℝ)| * AbcTwoNinths.Diamond.height q v := by
  rw [← AbcSubexp.Prerequisites.height_smul]
  simp [AbcTwoNinths.Diamond.height, AbcTwoNinths.Diamond.side, Fintype.sum_sum_type, tuplePrimes, tupleCombination, oldCombination]

private theorem coordinate_box {I : Type*} [Fintype I] (pr : I → ℕ)
    (hpr : ∀ j, (pr j).Prime) (v : I → ℤ) (i : I) (Y : ℝ)
    (hlog : 1 ≤ Real.log (pr i)) (h : AbcTwoNinths.Diamond.height pr v ≤ Y) :
    v i ∈ Finset.Icc (-(⌊Y⌋₊ : ℤ)) ⌊Y⌋₊ := by
  have each (w : I → ℤ) (hw : AbcTwoNinths.Diamond.side pr w ≤ Y) : (w i : ℝ) ≤ Y := by
    have hpos (j : I) := Real.log_nonneg (by exact_mod_cast (hpr j).one_lt.le : (1:ℝ) ≤ pr j)
    calc
      (w i : ℝ) ≤ max (w i : ℝ) 0 := le_max_left _ _
      _ ≤ max (w i : ℝ) 0 * Real.log (pr i) := le_mul_of_one_le_right (le_max_right _ _) hlog
      _ ≤ AbcTwoNinths.Diamond.side pr w := Finset.single_le_sum (f := fun j => max (w j : ℝ) 0 * Real.log (pr j))
        (fun j _ => mul_nonneg (le_max_right _ _) (hpos j)) (Finset.mem_univ i)
      _ ≤ Y := hw
  have hpos := each v ((le_max_left _ _).trans h)
  have hneg : -(v i : ℝ) ≤ Y := by simpa using each (-v) ((le_max_right _ _).trans h)
  have hf : (v i).natAbs ≤ ⌊Y⌋₊ := by
    apply Nat.le_floor
    simpa only [← Int.cast_natCast (R := ℝ), ← Int.abs_eq_natAbs, Int.cast_abs] using
      (abs_le.mpr ⟨by linarith, hpos⟩ : |(v i : ℝ)| ≤ Y)
  exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩

/-- An actual short integral combination admits an oriented coefficient pattern.
The pure axial case is excluded by the height of the axis. -/
theorem shortTuple_certificate (q : ι → ℕ) (hq : ∀ i, (q i).Prime) (prime : Q → ℕ)
    (hprime : ∀ s, (prime s).Prime) (hlog : ∀ s, 1 ≤ Real.log (prime s))
    (roof : ι) (v : ι → ℤ) (lift : Q → Q → ι → ℤ) (Y : ℝ) (hY : 0 ≤ Y)
    (haxis : Y < AbcTwoNinths.Diamond.height q v) (t : Q × (Fin n → Q)) (a : ℤ) (c : Fin n → ℤ)
    (hn : a ≠ 0 ∨ c ≠ 0)
    (hshort : AbcTwoNinths.Diamond.height (tuplePrimes q prime t) (tupleCombination v lift t a c) ≤ Y) :
    ∃ (i : Fin n) (a' : ℤ) (c' : Fin n → ℤ), 0 < c' i ∧
      (∀ j, c' j ∈ Finset.Icc (-(⌊Y⌋₊ : ℤ)) ⌊Y⌋₊) ∧
      oldCombination v lift t a' c' roof ∈ Finset.Icc (-(⌊Y / Real.log 2⌋₊ : ℤ)) ⌊Y / Real.log 2⌋₊ := by
  classical
  have hc : c ≠ 0 := by
    rintro rfl
    have ha := hn.resolve_right (by simp)
    have habs : 1 ≤ |(a : ℝ)| := by
      have h' : (1 : ℤ) ≤ |a| := Int.add_one_le_iff.mpr (abs_pos.mpr ha)
      exact_mod_cast h'
    rw [height_axis] at hshort
    linarith [le_mul_of_one_le_left (hY.trans haxis.le) habs]
  obtain ⟨i, hi⟩ : ∃ i, c i ≠ 0 := by simpa [funext_iff] using hc
  have pr (j) : (tuplePrimes q prime t j).Prime := by
    rcases j with j | (j | j)
    · exact hq j
    · exact hprime t.1
    · exact hprime (t.2 j)
  have orient (a' : ℤ) (c' : Fin n → ℤ) (hi' : 0 < c' i)
      (hs : AbcTwoNinths.Diamond.height (tuplePrimes q prime t) (tupleCombination v lift t a' c') ≤ Y) :
      0 < c' i ∧ (∀ j, c' j ∈ Finset.Icc (-(⌊Y⌋₊ : ℤ)) ⌊Y⌋₊) ∧
      oldCombination v lift t a' c' roof ∈
        Finset.Icc (-(⌊Y / Real.log 2⌋₊ : ℤ)) ⌊Y / Real.log 2⌋₊ := by
    refine ⟨hi', fun j => coordinate_box _ pr _ (.inr (.inr j)) Y (hlog (t.2 j)) hs, ?_⟩
    let pair : AbcTwoNinths.Diamond.Pair := ⟨(2,3), by decide, by decide, by decide⟩
    exact AbcSubexp.Prerequisites.roof_bound _ pr (.inl roof) pair (tupleCombination v lift t a' c') 0 Y
      (by rw [AbcSubexp.Prerequisites.planeHeight_zero]; exact hs)
  by_cases h : 0 < c i
  · exact ⟨i, a, c, orient a c h hshort⟩
  · exact ⟨i, -a, -c, orient (-a) (-c) (by change 0 < -c i; omega)
      (by rw [tupleCombination_neg, AbcSubexp.Prerequisites.height_neg]; exact hshort)⟩

private theorem realTupleBudget (m N : ℕ) (T Y : ℝ) (hT : 0 ≤ T) (hY : 1 ≤ Y) :
    let D := ((AbcTwoNinths.Diamond.productPairs ⌊Real.exp (2*T)⌋₊).card : ℝ)
    let B := (⌊Y⌋₊ : ℝ)
    let C := (⌊Y / Real.log 2⌋₊ : ℝ)
    D * (2*B) * (m * (2*B+1)^m * (N:ℝ)^m * (2*C+1) * B) ≤
      10 * (8:ℝ)^(m+1) * Y^(m+3) * (1+2*T) * Real.exp (2*T) * (N:ℝ)^m := by
  dsimp only
  have hB := Nat.floor_le (show 0 ≤ Y by linarith)
  have hl : (1:ℝ)/2 ≤ Real.log 2 := by linarith [Real.log_two_gt_d9]
  have hC : (⌊Y / Real.log 2⌋₊ : ℝ) ≤ 2*Y := by
    refine (Nat.floor_le (div_nonneg (by linarith) (by linarith))).trans ?_
    apply (div_le_iff₀ (by linarith : 0 < Real.log 2)).mpr
    nlinarith [mul_le_mul_of_nonneg_left hl (show 0 ≤ 2*Y by linarith)]
  have hdim (j : ℕ) : (j : ℝ) ≤ 2^j := by
    induction j with
    | zero => norm_num
    | succ j ih =>
      rw [Nat.cast_succ, pow_succ]
      linarith [one_le_pow₀ (show (1:ℝ) ≤ 2 by norm_num) (n := j)]
  have hpow : (m:ℝ) * 3^m ≤ (8:ℝ)^(m+1) := by
    calc
      _ ≤ 2^m * 3^m := mul_le_mul_of_nonneg_right (hdim m) (by positivity)
      _ = 6^m := by rw [← mul_pow]; norm_num
      _ ≤ 8^m := by gcongr; norm_num
      _ ≤ _ := by rw [pow_succ]; linarith [show 0 ≤ (8:ℝ)^m by positivity]
  calc
    _ ≤ (Real.exp (2*T) * (1+2*T)) * (2*Y) *
        ((m:ℝ) * (3*Y)^m * (N:ℝ)^m * (5*Y) * Y) := by
      gcongr
      · exact AbcTwoNinths.Diamond.productPairsCardExpLe _ (by linarith)
      · linarith
      · linarith
    _ = (m * (3:ℝ)^m) * (10 * Y^(m+3) * (1+2*T) * Real.exp (2*T) * (N:ℝ)^m) := by
      rw [mul_pow, pow_add]
      ring
    _ ≤ _ := by
      have hn : 0 ≤ 10 * Y^(m+3) * (1+2*T) * Real.exp (2*T) * (N:ℝ)^m := by positivity
      calc
        _ ≤ _ := mul_le_mul_of_nonneg_right hpow hn
        _ = _ := by ring

/-- The short-tuple count underlying Proposition 4.2 for rank `k+2` and height `Y`.
Each member of `S`
has a short nonzero integral combination of the chosen generators. -/
theorem shortTuple_card_le [Fintype Q] {p k : ℕ} [Fact p.Prime]
    (S : Finset (Q × (Fin (k+1) → Q))) (prime : Q ↪ ℕ) (hprime : ∀ s, (prime s).Prime)
    (hodd : ∀ s, prime s ≠ 2) (hwindow : ∀ s, prime s * 2 < p)
    (hlog : ∀ s, 1 ≤ Real.log (prime s))
    (unit : Q → (ZMod p)ˣ) (hunit : ∀ s, (unit s : ZMod p) = (prime s : ZMod p))
    (q : ι → ℕ) (hq : ∀ i, (q i).Prime) (hiq : Function.Injective q)
    (roof : ι) (v : ι → ℤ) (hv : v roof ≠ 0) (T Y : ℝ) (hT : 0 ≤ T) (hY : 1 ≤ Y)
    (hheight : Y < AbcTwoNinths.Diamond.height q v) (red : AbcTwoNinths.ExteriorE2.Exponents ι →* (ZMod p)ˣ)
    (haxis : AbcTwoNinths.Diamond.quotientLabel (red (Multiplicative.ofAdd v)) = 1)
    (lift : Q → Q → ι → ℤ) (hcost : ∀ s t, AbcTwoNinths.Diamond.cost q (AbcTwoNinths.Diamond.roofProjection roof v (lift s t)) ≤ T)
    (hlift : ∀ s t, AbcTwoNinths.Diamond.quotientLabel (red (Multiplicative.ofAdd (lift s t))) *
        AbcTwoNinths.Diamond.quotientLabel (unit s / unit t) = 1)
    (hshort : ∀ t ∈ S, ∃ (a : ℤ) (c : Fin (k+1) → ℤ), (a ≠ 0 ∨ c ≠ 0) ∧
      AbcTwoNinths.Diamond.height (tuplePrimes q prime t) (tupleCombination v lift t a c) ≤ Y) :
    (S.card : ℝ) ≤ 10 * (8:ℝ)^(k+2) * Y^(k+4) * (1+2*T) * Real.exp (2*T) * (Fintype.card Q : ℝ)^(k+1) := by
  classical
  let mark : Q ↪ AbcTwoNinths.Diamond.Pair := ⟨fun s => markedPrime (prime s) (hprime s) (hodd s),
    fun x y h => prime.injective (congrArg (fun z : AbcTwoNinths.Diamond.Pair => z.val.1) h)⟩
  let eval (t : Q) (b : ℕ) (w : ι → ℤ) :=
    (red (Multiplicative.ofAdd w) : ZMod p) * (2 / (unit t : ZMod p)) ^ b
  have signed (t s : Q) (a : ℤ) (b : ℕ) := signedMarkedPower red v (lift s t) a b
    (mark s) (2 / (unit t : ZMod p)) (unit s / unit t)
  have hratio (t s : Q) : ((unit s / unit t : (ZMod p)ˣ) : ZMod p) =
      2 / (unit t : ZMod p) * AbcTwoNinths.Diamond.ratio p (mark s) := by
    have hbig : 2 < p := by have := hwindow s; have := (hprime s).two_le; omega
    have h₂ : (2 : ZMod p) ≠ 0 := by
      intro h
      have he := congrArg ZMod.val (show ((2 : ℕ) : ZMod p) = 0 by simpa using h)
      rw [ZMod.val_natCast_of_lt hbig, ZMod.val_zero] at he
      omega
    rw [Units.val_div_eq_div_val]
    change (unit s : ZMod p) / (unit t : ZMod p) =
      2 / (unit t : ZMod p) * ((prime s : ℕ) / (2 : ZMod p))
    rw [hunit s]
    field_simp
  have hn := badTupleCertificate_card_le S mark (markedPrime_crossBound prime hprime hodd hwindow)
    q hq hiq roof v hv T ⌊Y⌋₊ ⌊Y / Real.log 2⌋₊ lift hcost eval
    (fun t s a b => signed t s a b (hratio t s) haxis (hlift s t))
    (fun t ht => by
      obtain ⟨a, c, hn, hh⟩ := hshort t ht
      exact shortTuple_certificate q hq prime hprime hlog roof v lift Y (by linarith) hheight t a c hn hh)
  have hreal := realTupleBudget (k+1) (Fintype.card Q) T Y hT hY
  exact (show (S.card:ℝ) ≤ _ by exact_mod_cast hn).trans hreal

/-- A finite candidate family exceeding the short-tuple bound contains a tuple whose
generated lattice has no nonzero vector of height at most `Y`. -/
theorem exists_tall_prime_tuple [Fintype Q] {p k : ℕ} [Fact p.Prime]
    (candidates : Finset (Q × (Fin (k+1) → Q))) (prime : Q ↪ ℕ)
    (hprime : ∀ s, (prime s).Prime) (hodd : ∀ s, prime s ≠ 2)
    (hwindow : ∀ s, prime s * 2 < p) (hlog : ∀ s, 1 ≤ Real.log (prime s))
    (unit : Q → (ZMod p)ˣ) (hunit : ∀ s, (unit s : ZMod p) = (prime s : ZMod p))
    (q : ι → ℕ) (hq : ∀ i, (q i).Prime) (hiq : Function.Injective q)
    (roof : ι) (v : ι → ℤ) (hv : v roof ≠ 0) (T Y : ℝ) (hT : 0 ≤ T) (hY : 1 ≤ Y)
    (hheight : Y < AbcTwoNinths.Diamond.height q v) (red : AbcTwoNinths.ExteriorE2.Exponents ι →* (ZMod p)ˣ)
    (haxis : AbcTwoNinths.Diamond.quotientLabel (red (Multiplicative.ofAdd v)) = 1)
    (lift : Q → Q → ι → ℤ) (hcost : ∀ s t, AbcTwoNinths.Diamond.cost q (AbcTwoNinths.Diamond.roofProjection roof v (lift s t)) ≤ T)
    (hlift : ∀ s t, AbcTwoNinths.Diamond.quotientLabel (red (Multiplicative.ofAdd (lift s t))) *
        AbcTwoNinths.Diamond.quotientLabel (unit s / unit t) = 1)
    (hgap : 10 * (8:ℝ)^(k+2) * Y^(k+4) * (1+2*T) * Real.exp (2*T) *
        (Fintype.card Q : ℝ)^(k+1) < candidates.card) :
    ∃ t ∈ candidates, ∀ (a : ℤ) (c : Fin (k+1) → ℤ), (a ≠ 0 ∨ c ≠ 0) →
      Y < AbcTwoNinths.Diamond.height (tuplePrimes q prime t) (tupleCombination v lift t a c) := by
  by_contra! hbad
  exact hgap.not_ge (shortTuple_card_le candidates prime hprime hodd hwindow hlog unit hunit
    q hq hiq roof v hv T Y hT hY hheight red haxis lift hcost hlift hbad)

end AbcSubexp.TupleCounting
